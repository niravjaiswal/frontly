{
  "name": "frontly",
  "version": "1.0.0",
  "description": "A CLI developer tool for creating and editing React + Vite frontend projects",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "frontly": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cli",
    "react",
    "vite",
    "gemini",
    "ai",
    "code-generation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "ink": "^5.0.1",
    "ink-markdown": "^1.0.2",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
